<%- include('../partials/header') %>
  <div class="card">
    <h1><%= t('admin.pendingRequests') %></h1>
    <% if (pendingRequests.length === 0) { %>
      <p><%= t('admin.noPending') %></p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th></th>
            <th><%= t('admin.name') %></th>
            <th><%= t('admin.source') %></th>
            <th><%= t('admin.contact') %></th>
            <th><%= t('admin.requested') %></th>
            <th><%= t('admin.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% pendingRequests.forEach(function(r) { %>
            <tr>
              <td><% if (r.picture) { %><img src="<%= r.picture %>" alt="" style="width:32px;height:32px;border-radius:50%;vertical-align:middle"><% } %></td>
              <td>
                <%= r.name || t('admin.unknown') %>
                <% if (r.firstName) { %><br><span style="font-size:0.8rem;color:var(--text-secondary)"><%= r.firstName %><% if (r.lastName) { %> <%= r.lastName %><% } %></span><% } %>
              </td>
              <td><span class="badge badge-<%= r.sourceType %>"><%= r.sourceType %></span></td>
              <td><%= r.email || (r.username ? '@' + r.username : '') || r.sourceUserId %></td>
              <td><%= new Date(r.requestedAt).toLocaleString() %></td>
              <td>
                <button type="button" class="btn btn-success" data-action="/api/admin/pending/<%= r.id %>/allow" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;"><%= t('admin.allow') %></button>
                <button type="button" class="btn btn-danger" data-action="/api/admin/pending/<%= r.id %>/deny" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;"><%= t('admin.deny') %></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <a href="/admin">&larr; <%= t('admin.back') %></a>
  <script>
    (function() {
      var buttons = document.querySelectorAll('[data-action]');
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          btn.disabled = true;
          fetch(btn.getAttribute('data-action'), { method: 'POST' })
            .then(function(r) {
              if (!r.ok) throw new Error('failed');
              location.reload();
            })
            .catch(function() {
              btn.disabled = false;
            });
        });
      });
    })();
  </script>
<%- include('../partials/footer') %>
