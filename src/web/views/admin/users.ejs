<%- include('../partials/header') %>
  <div class="card">
    <h1><%= t('admin.allowedUsers') %></h1>
    <% if (allowedUsers.length === 0) { %>
      <p><%= t('admin.noUsers') %></p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th></th>
            <th><%= t('admin.name') %></th>
            <th><%= t('admin.source') %></th>
            <th><%= t('admin.contact') %></th>
            <th><%= t('admin.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% allowedUsers.forEach(function(u) { %>
            <tr>
              <td><% if (u.picture) { %><img src="<%= u.picture %>" alt="" style="width:32px;height:32px;border-radius:50%;vertical-align:middle"><% } %></td>
              <td>
                <%= u.name %>
                <% if (u.firstName) { %><br><span style="font-size:0.8rem;color:var(--text-secondary)"><%= u.firstName %><% if (u.lastName) { %> <%= u.lastName %><% } %></span><% } %>
              </td>
              <td><span class="badge badge-<%= u.sourceType %>"><%= u.sourceType %></span></td>
              <td><%= u.email || u.sourceUserId %></td>
              <td>
                <button type="button" class="btn btn-danger" data-action="/api/admin/users/<%= u.sourceType %>/<%= u.sourceUserId %>/remove" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;"><%= t('admin.remove') %></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <a href="/admin">&larr; <%= t('admin.back') %></a>
  <script>
    (function() {
      var buttons = document.querySelectorAll('[data-action]');
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          btn.disabled = true;
          fetch(btn.getAttribute('data-action'), { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
            .then(function(r) {
              if (r.status === 401 || r.status === 403) {
                window.location.href = '/';
                return;
              }
              if (!r.ok) throw new Error('failed');
              location.reload();
            })
            .catch(function() {
              btn.disabled = false;
            });
        });
      });
    })();
  </script>
<%- include('../partials/footer') %>
