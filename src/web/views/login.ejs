<%- include('partials/header', { user: null }) %>
  <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
    <img src="/assets/logo.png" alt="Gate Bot logo" style="width: 200px; height: 200px; border-radius: 50%; object-fit: cover; margin-bottom: 1rem;">
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;"><%= t('login.title') %></h1>
    <p style="margin-bottom: 1.5rem;"><%= t('login.subtitle') %></p>

    <% if (typeof showPasswordLogin !== 'undefined' && showPasswordLogin) { %>
      <div id="loginError" class="message message-error" role="alert" style="display: none;"></div>
      <form id="loginForm" style="margin-bottom: 1.5rem;">
        <div style="margin-bottom: 0.75rem;">
          <input type="text" id="username" aria-label="<%= t('login.username') %>" placeholder="<%= t('login.username') %>" required style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); font-size: 0.9rem;">
        </div>
        <div style="margin-bottom: 0.75rem;">
          <input type="password" id="password" aria-label="<%= t('login.password') %>" placeholder="<%= t('login.password') %>" required style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); font-size: 0.9rem;">
        </div>
        <button type="submit" class="btn" id="loginBtn" style="width: 100%; justify-content: center;"><%= t('login.signInPassword') %></button>
      </form>
      <div style="border-top: 1px solid var(--border); margin: 1.5rem 0;"></div>
    <% } %>

    <a href="/auth/google" class="btn btn-google">
      <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg>
      <%= t('login.signIn') %>
    </a>

    <% if (typeof telegramUsername !== 'undefined' && telegramUsername) { %>
      <div style="margin-top: 1rem;">
        <a href="https://t.me/<%= telegramUsername %>" target="_blank" rel="noopener noreferrer" class="btn btn-google" style="width: 100%; justify-content: center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#4a9eff" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          <%= t('login.telegram') %>: @<%= telegramUsername %>
        </a>
      </div>
    <% } %>
  </div>
  <% if (typeof showPasswordLogin !== 'undefined' && showPasswordLogin) { %>
  <script>
    (function() {
      var form = document.getElementById('loginForm');
      var btn = document.getElementById('loginBtn');
      var errorEl = document.getElementById('loginError');
      if (!form) return;

      function showError(text) {
        errorEl.textContent = text;
        errorEl.style.display = '';
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        btn.disabled = true;
        errorEl.style.display = 'none';

        var body = new URLSearchParams();
        body.set('username', document.getElementById('username').value);
        body.set('password', document.getElementById('password').value);

        fetch('/api/auth/password', { method: 'POST', headers: { 'X-Requested-With': 'fetch' }, body: body })
          .then(function(r) { return r.json().then(function(d) { return { ok: r.ok && d.ok, data: d }; }); })
          .then(function(result) {
            if (result.ok) {
              window.location.href = '/';
              return;
            }
            if (result.data && result.data.error === 'missing') {
              showError('<%= t('login.missingCredentials') %>');
            } else {
              showError('<%= t('login.invalidCredentials') %>');
            }
          })
          .catch(function() {
            showError('<%= t('login.invalidCredentials') %>');
          })
          .finally(function() {
            btn.disabled = false;
          });
      });
    })();
  </script>
  <% } %>
<%- include('partials/footer') %>
