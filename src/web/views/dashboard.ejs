<%- include('partials/header') %>
  <% if (typeof message !== 'undefined' && message) { %>
    <div class="message message-info"><%= message.replace(/\n/g, '<br>') %></div>
  <% } %>

  <div class="card">
    <h1><%= t('dashboard.title') %></h1>
    <p><%= t('dashboard.signedInAs') %> <strong><%= user.name %></strong> (<%= user.email %>)</p>
    <% if (isAllowed) { %>
      <div class="message message-success"><%= t('dashboard.authorized') %></div>
      <form id="openForm">
        <button type="submit" class="btn" id="openBtn"><%= t('dashboard.openGate') %></button>
      </form>
      <div id="openMessage" style="display:none; margin-top: 1rem; white-space: pre-wrap;" class="message"></div>
    <% } else { %>
      <div class="message message-error"><%= t('dashboard.notAuthorized') %></div>
      <form id="requestAccessForm">
        <button type="submit" class="btn" id="requestAccessBtn"><%= t('dashboard.requestAccess') %></button>
      </form>
      <div id="requestAccessMessage" style="display:none; margin-top: 1rem; white-space: pre-wrap;" class="message"></div>
    <% } %>
  </div>

  <% if (isAllowed && (doorCode || parkingInfo || floor || unit || propertyNotes)) { %>
    <div class="card">
      <h1><%= t('dashboard.propertyInfo') %></h1>
      <table>
        <% if (doorCode) { %><tr><td><strong><%= t('dashboard.doorCode') %></strong></td><td><%= doorCode %></td></tr><% } %>
        <% if (parkingInfo) { %><tr><td><strong><%= t('dashboard.infoParking') %></strong></td><td><%= parkingInfo %></td></tr><% } %>
        <% if (floor) { %><tr><td><strong><%= t('dashboard.infoFloor') %></strong></td><td><%= floor %></td></tr><% } %>
        <% if (unit) { %><tr><td><strong><%= t('dashboard.infoUnit') %></strong></td><td><%= unit %></td></tr><% } %>
        <% if (propertyNotes) { %><tr><td><strong><%= t('dashboard.infoNotes') %></strong></td><td style="white-space: pre-wrap;"><%= propertyNotes %></td></tr><% } %>
      </table>
    </div>
  <% } %>

  <% if (isAllowed) { %>
  <script>
    (function() {
      var form = document.getElementById('openForm');
      var btn = document.getElementById('openBtn');
      var messageEl = document.getElementById('openMessage');
      var messageTimer;
      if (!form || !btn || !messageEl) return;

      function showMessage(ok, text) {
        messageEl.className = 'message ' + (ok ? 'message-success' : 'message-error');
        messageEl.textContent = text || '';
        messageEl.style.display = '';
        clearTimeout(messageTimer);
        messageTimer = setTimeout(function() {
          messageEl.style.display = 'none';
        }, 5000);
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        btn.disabled = true;

        fetch('/api/open', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
          .then(function(r) {
            if (r.status === 401) {
              window.location.href = '/';
              return null;
            }
            return r.json().then(function(data) { return { ok: r.ok && data.ok, data: data }; });
          })
          .then(function(result) {
            if (!result) return;
            showMessage(result.ok, result.data.message || '');
          })
          .catch(function() {
            showMessage(false, '<%= t('dashboard.openFailed') %>');
          })
          .finally(function() {
            btn.disabled = false;
          });
      });
    })();
  </script>
  <% } %>

  <% if (!isAllowed) { %>
  <script>
    (function() {
      var form = document.getElementById('requestAccessForm');
      var btn = document.getElementById('requestAccessBtn');
      var messageEl = document.getElementById('requestAccessMessage');
      if (!form || !btn || !messageEl) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        btn.disabled = true;

        fetch('/api/request-access', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
          .then(function(r) {
            if (r.status === 401) {
              window.location.href = '/';
              return null;
            }
            return r.json().then(function(data) { return { ok: r.ok && data.ok, data: data }; });
          })
          .then(function(result) {
            if (!result) return;
            messageEl.className = 'message ' + (result.ok ? 'message-success' : 'message-error');
            messageEl.textContent = result.data.message || '';
            messageEl.style.display = '';
            if (!result.ok) {
              btn.disabled = false;
            }
          })
          .catch(function() {
            btn.disabled = false;
          });
      });
    })();
  </script>
  <script>
    (function() {
      var pollId;

      function checkAuth() {
        fetch('/api/status')
          .then(function(r) {
            if (!r.ok) {
              clearInterval(pollId);
              window.location.href = '/';
              return null;
            }
            return r.json();
          })
          .then(function(data) {
            if (data && data.allowed) {
              clearInterval(pollId);
              location.reload();
            }
          });
      }

      pollId = setInterval(checkAuth, 3000);
    })();
  </script>
  <% } %>
<%- include('partials/footer') %>
