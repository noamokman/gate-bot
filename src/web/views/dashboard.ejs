<%- include('partials/header') %>
  <% if (typeof message !== 'undefined' && message) { %>
    <div class="message message-info"><%= message.replace(/\n/g, '<br>') %></div>
  <% } %>

  <div class="card">
    <h1><%= t('dashboard.title') %></h1>
    <p><%= t('dashboard.signedInAs') %> <strong><%= user.name %></strong> (<%= user.email %>)</p>
    <% if (isAllowed) { %>
      <div class="message message-success"><%= t('dashboard.authorized') %></div>
      <form id="openForm">
        <button type="submit" class="btn" id="openBtn"><%= t('dashboard.openGate') %></button>
      </form>
      <div id="openMessage" style="display:none; margin-top: 1rem; white-space: pre-wrap;" class="message"></div>
    <% } else { %>
      <div class="message message-error"><%= t('dashboard.notAuthorized') %></div>
      <form id="requestAccessForm">
        <button type="submit" class="btn" id="requestAccessBtn"><%= t('dashboard.requestAccess') %></button>
      </form>
      <div id="requestAccessMessage" style="display:none; margin-top: 1rem; white-space: pre-wrap;" class="message"></div>
    <% } %>
  </div>

  <% if (isAllowed && (doorCode || parkingInfo || floor || unit || propertyNotes)) { %>
    <div class="card">
      <h1><%= t('dashboard.propertyInfo') %></h1>
      <table>
        <% if (doorCode) { %><tr><td><strong><%= t('dashboard.doorCode') %></strong></td><td><%= doorCode %></td></tr><% } %>
        <% if (parkingInfo) { %><tr><td><strong><%= t('dashboard.infoParking') %></strong></td><td><%= parkingInfo %></td></tr><% } %>
        <% if (floor) { %><tr><td><strong><%= t('dashboard.infoFloor') %></strong></td><td><%= floor %></td></tr><% } %>
        <% if (unit) { %><tr><td><strong><%= t('dashboard.infoUnit') %></strong></td><td><%= unit %></td></tr><% } %>
        <% if (propertyNotes) { %><tr><td><strong><%= t('dashboard.infoNotes') %></strong></td><td style="white-space: pre-wrap;"><%= propertyNotes %></td></tr><% } %>
      </table>
    </div>
  <% } %>

  <div class="card">
    <h1><%= t('dashboard.share') %></h1>
    <p><%= t('dashboard.shareHint') %></p>
    <div class="share-actions">
      <button type="button" class="btn" id="shareWebBtn" data-share-url="<%= webUrl %>" data-share-text="<%= t('dashboard.shareWebText') %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
        <%= t('dashboard.shareWeb') %>
      </button>
      <% if (typeof telegramUsername !== 'undefined' && telegramUsername) { %>
        <button type="button" class="btn" id="shareTelegramBtn" data-share-url="https://t.me/<%= telegramUsername %>" data-share-text="<%= t('dashboard.shareTelegramText') %>">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          <%= t('dashboard.shareTelegram') %>
        </button>
      <% } %>
    </div>
    <div id="shareMessage" class="message sr-only" role="status" aria-live="polite" style="margin-top: 1rem;"></div>
  </div>

  <script>
    (function() {
      var buttons = document.querySelectorAll('[data-share-url]');
      var messageEl = document.getElementById('shareMessage');
      if (!buttons.length || !messageEl) return;
      var messageTimer;
      var restoreTimer;

      // A live region does not re-announce unchanged text, so clear it and set the new text in a
      // later task: two consecutive identical results (web link, then Telegram link) both announce.
      function showMessage(ok, text) {
        clearTimeout(messageTimer);
        clearTimeout(restoreTimer);
        messageEl.textContent = '';
        messageEl.className = 'message ' + (ok ? 'message-success' : 'message-error');
        restoreTimer = setTimeout(function() {
          messageEl.textContent = text || '';
        }, 0);
        messageTimer = setTimeout(function() {
          messageEl.className = 'message sr-only';
          messageEl.textContent = '';
        }, 5000);
      }

      function copyLink(url) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(url);
        }
        return Promise.reject(new Error('clipboard_unavailable'));
      }

      function share(btn) {
        var url = btn.getAttribute('data-share-url');
        var text = btn.getAttribute('data-share-text');
        if (!url) return;

        if (navigator.share) {
          navigator.share({ text: text, url: url }).catch(function(err) {
            if (err && err.name === 'AbortError') return;
            copyLink(url)
              .then(function() { showMessage(true, '<%= t("dashboard.shareCopied") %>'); })
              .catch(function() { showMessage(false, '<%= t("dashboard.shareFailed") %>'); });
          });
          return;
        }

        copyLink(url)
          .then(function() { showMessage(true, '<%= t("dashboard.shareCopied") %>'); })
          .catch(function() { showMessage(false, '<%= t("dashboard.shareFailed") %>'); });
      }

      Array.prototype.forEach.call(buttons, function(btn) {
        btn.addEventListener('click', function() { share(btn); });
      });
    })();
  </script>

  <% if (isAllowed) { %>
  <script>
    (function() {
      var form = document.getElementById('openForm');
      var btn = document.getElementById('openBtn');
      var messageEl = document.getElementById('openMessage');
      var messageTimer;
      if (!form || !btn || !messageEl) return;

      function showMessage(ok, text) {
        messageEl.className = 'message ' + (ok ? 'message-success' : 'message-error');
        messageEl.textContent = text || '';
        messageEl.style.display = '';
        clearTimeout(messageTimer);
        messageTimer = setTimeout(function() {
          messageEl.style.display = 'none';
        }, 5000);
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        btn.disabled = true;

        fetch('/api/open', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
          .then(function(r) {
            if (r.status === 401) {
              window.location.href = '/';
              return null;
            }
            return r.json().then(function(data) { return { ok: r.ok && data.ok, data: data }; });
          })
          .then(function(result) {
            if (!result) return;
            showMessage(result.ok, result.data.message || '');
          })
          .catch(function() {
            showMessage(false, '<%= t('dashboard.openFailed') %>');
          })
          .finally(function() {
            btn.disabled = false;
          });
      });
    })();
  </script>
  <% } %>

  <% if (!isAllowed) { %>
  <script>
    (function() {
      var form = document.getElementById('requestAccessForm');
      var btn = document.getElementById('requestAccessBtn');
      var messageEl = document.getElementById('requestAccessMessage');
      if (!form || !btn || !messageEl) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        btn.disabled = true;

        fetch('/api/request-access', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
          .then(function(r) {
            if (r.status === 401) {
              window.location.href = '/';
              return null;
            }
            return r.json().then(function(data) { return { ok: r.ok && data.ok, data: data }; });
          })
          .then(function(result) {
            if (!result) return;
            messageEl.className = 'message ' + (result.ok ? 'message-success' : 'message-error');
            messageEl.textContent = result.data.message || '';
            messageEl.style.display = '';
            if (!result.ok) {
              btn.disabled = false;
            }
          })
          .catch(function() {
            btn.disabled = false;
          });
      });
    })();
  </script>
  <script>
    (function() {
      var pollId;

      function checkAuth() {
        fetch('/api/status')
          .then(function(r) {
            if (!r.ok) {
              clearInterval(pollId);
              window.location.href = '/';
              return null;
            }
            return r.json();
          })
          .then(function(data) {
            if (data && data.allowed) {
              clearInterval(pollId);
              location.reload();
            }
          });
      }

      pollId = setInterval(checkAuth, 3000);
    })();
  </script>
  <% } %>
<%- include('partials/footer') %>
